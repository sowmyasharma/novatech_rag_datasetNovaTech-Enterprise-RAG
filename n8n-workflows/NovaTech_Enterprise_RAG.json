    {
      "parameters": {
        "jsCode": "const input=$input.all();\nconst raw=input.flatMap(item=>Array.isArray(item.json)?item.json:Array.isArray(item.json.documents)?item.json.documents:[item.json]);\nif(!raw.length) throw new Error('Dataset empty; check source URL');\nreturn raw.map(d=>{\n if(!d.document_id||!Array.isArray(d.sections))throw new Error('Invalid canonical document: '+JSON.stringify(d).slice(0,150));\n const text=['# '+(d.title||d.document_id),...d.sections.map(s=>'## '+s.heading+'\\n'+s.text)].join('\\n\\n');\n return {json:{text,document_id:d.document_id,title:d.title||'',department:d.department||'',version:String(d.version||''),status:d.status||'',region:d.region||'',access_level:d.access_level||'',owner:d.owner||'',effective_date:d.effective_date||'',source_format:d.format||'',source_path:d.file_path||'',related_document_ids:JSON.stringify(d.related_document_ids||[])}};\n});"
      },
